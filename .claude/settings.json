{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker exec tadka-mc-postgres psql:*)",
      "Bash(k6 run:*)",
      "Bash(k6 version:*)",
      "Bash(curl:*)",
      "Bash(dotnet build:*)",
      "Bash(dotnet run:*)",
      "Bash(./scripts/reset.sh:*)",
      "Bash(./scripts/pg-activity.sh:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(docker system prune:*)",
      "Bash(docker volume rm:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-context.sh\""
          }
        ]
      }
    ]
  }
}
